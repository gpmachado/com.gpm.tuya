      "values": [
        { "id": "single", "label": { "en": "Single", "de": "Einzelklick", "es": "Única", "it": "Singola" } },
        { "id": "double", "label": { "en": "Double", "de": "Doppelklick", "es": "Doble", "it": "Doppia" } },
        { "id": "long",   "label": { "en": "Hold", "de": "Halten", "es": "Mantener", "it": "Tieni premuto" } }
